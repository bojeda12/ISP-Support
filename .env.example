# Referencia: definir estas variables en PowerShell; no se carga .env automáticamente.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_ENGINE=sqlite
# Para PostgreSQL posteriormente: DB_ENGINE=postgresql y completar estas variables.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
