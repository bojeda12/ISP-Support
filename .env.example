# .env se carga solo en desarrollo/test, sin sobrescribir variables del proceso.
DJANGO_DEBUG=true
DJANGO_TIME_ZONE=UTC
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_ENGINE=sqlite
# Para PostgreSQL posteriormente: DB_ENGINE=postgresql y completar estas variables.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
# Chat de demo: habilitar solo en desarrollo local, requiere sesión autorizada.
DJANGO_ENV=development
ENABLE_DEMO_CHAT=false
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
AI_TIMEOUT_SECONDS=15
# Requiere además autorización explícita por documento en Django Admin.
KNOWLEDGE_ALLOW_EXTERNAL_AI=false
# Permitir revisión técnica por intentos inconclusos con evidencia suficiente.
# No modifica prioridades, transiciones ni permisos de tickets.
CHAT_ALLOW_INCONCLUSIVE_REVIEW=true
